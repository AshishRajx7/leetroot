# Real-World DSA Pattern Finder (LeetRoot) Environment Config

PORT=4000
NODE_ENV=development

# Postgres Database Configuration
DATABASE_URL=postgresql://leetroot:leetroot_secret@localhost:5432/leetroot
POSTGRES_USER=leetroot
POSTGRES_PASSWORD=leetroot_secret
POSTGRES_DB=leetroot
POSTGRES_PORT=5432

# Redis Configuration (BullMQ & Cache)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
CACHE_TTL_SECONDS=86400

# NVIDIA NIM Configuration (OpenAI-compatible)
# Sign up at https://build.nvidia.com for 1,000 free credits, no card required
NVIDIA_NIM_API_KEY=nvapi-demo-key-replace-with-yours
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct

# GitHub API Token (Optional, for higher rate limits when cloning/scanning trees)
GITHUB_TOKEN=
