# Real-World DSA Pattern Finder (LeetRoot) Dedicated Test Environment Config
# Used by integration tests (NODE_ENV=test) to isolate tests from development data.

NODE_ENV=test
PORT=4001

# Dedicated Test Database (Must NOT point to development database)
DATABASE_URL=postgresql://leetroot:leetroot_secret@localhost:5432/leetroot_test
TEST_DATABASE_URL=postgresql://leetroot:leetroot_secret@localhost:5432/leetroot_test
POSTGRES_USER=leetroot
POSTGRES_PASSWORD=leetroot_secret
POSTGRES_DB=leetroot_test
POSTGRES_TEST_DB=leetroot_test
POSTGRES_PORT=5432

# Dedicated Test Redis (Logical DB 1 to prevent cache/queue collisions with dev DB 0)
REDIS_URL=redis://localhost:6379/1
TEST_REDIS_URL=redis://localhost:6379/1
REDIS_PORT=6379
CACHE_TTL_SECONDS=300

# NIM Verification: Empty by default in tests to ensure strict fail-closed guarantees
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct

GITHUB_TOKEN=